#!/usr/bin/env python3
from pathlib import Path
from yyjson import Document

def sizeof(x):
    """Approximate byte size of a JSON subtree."""
    t = type(x)
    if t is dict:
        return sum(len(k) + sizeof(v) for k, v in x.items())
    if t is list:
        return sum(sizeof(v) for v in x)
    if t is str:
        return len(x)
    return 8  # numbers, bools, null

def walk(x, path="root"):
    """Yield (path, size) pairs for each subtree."""
    if isinstance(x, dict):
        yield path, sizeof(x)
        for k, v in x.items():
            yield from walk(v, f"{path}.{k}")
    elif isinstance(x, list):
        yield path, sizeof(x)
        for i, v in enumerate(x):
            yield from walk(v, f"{path}[{i}]")

def main(filename):
    doc = Document(Path(filename))
    root = doc.as_obj
    sizes = sorted(walk(root), key=lambda kv: kv[1], reverse=True)
    for p, s in sizes[:50]:
        print(f"{s:10d}  {p}")

if __name__ == "__main__":
    import sys
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} file.json")
        sys.exit(1)
    main(sys.argv[1])
